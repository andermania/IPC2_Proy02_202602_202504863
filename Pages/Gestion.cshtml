@page
@model GestiónDeBiblioteca.Pages.GestionModel

<div class="container mt-4">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">
            Gestión de Libros
        </h1>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.MensajeExito
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.MensajeError
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">

        @* ========== REGISTRAR NUEVO LIBRO ========== *@
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Registrar Nuevo Libro</h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Registrar">

                        <div class="mb-3">
                            <label class="form-label fw-bold">ISBN</label>
                            <input asp-for="ISBN"
                                   type="number"
                                   class="form-control"
                                   placeholder="Ej: 1234"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Título</label>
                            <input asp-for="Titulo"
                                   type="text"
                                   class="form-control"
                                   placeholder="Ej: Cien años de soledad"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Autor</label>
                            <input asp-for="Autor"
                                   type="text"
                                   class="form-control"
                                   placeholder="Ej: Gabriel García Márquez"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Categoría</label>
                            <select asp-for="CategoriaSeleccionada"
                                    asp-items="Model.OpcionesCategorias"
                                    class="form-select"
                                    id="selectCategoria"
                                    required>
                                <option value="">-- Seleccione una categoría --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Subcategoría (opcional)</label>
                            <select asp-for="SubcategoriaSeleccionada"
                                    asp-items="Model.OpcionesSubcategorias"
                                    class="form-select"
                                    id="selectSubcategoria">
                                <option value="">-- Sin subcategoría --</option>
                            </select>
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">
                            Registrar Libro
                        </button>

                    </form>
                </div>
            </div>
        </div>

        @* ========== BUSCAR LIBRO ========== *@
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Buscar Libro</h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="Buscar">
                        <div class="mb-3">
                            <label class="form-label fw-bold">ISBN (árbol AVL por ISBN)</label>
                            <input asp-for="BusquedaISBN"
                                   type="number"
                                   class="form-control"
                                   placeholder="Ingrese el ISBN a buscar" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Título (árbol AVL alfabético)</label>
                            <input asp-for="BusquedaTitulo"
                                   type="text"
                                   class="form-control"
                                   placeholder="Ingrese el título a buscar" />
                        </div>
                        <button type="submit"
                                class="btn btn-primary w-100">
                            Buscar
                        </button>
                    </form>

                    @if (Model.LibroEncontrado != null)
                    {
                        <hr />
                        <div class="card bg-light position-relative">
                            <form method="post" asp-page-handler="EliminarIndividual" asp-route-isbn="@Model.LibroEncontrado.ISBN" onsubmit="return confirm('¿Eliminar el libro con ISBN @Model.LibroEncontrado.ISBN de todo el catálogo?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2" title="Eliminar libro">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/></svg>
                                </button>
                            </form>
                            <div class="card-body">
                                <h5 class="card-title">@Model.LibroEncontrado.Titulo</h5>
                                <p class="mb-1"><strong>ISBN:</strong> @Model.LibroEncontrado.ISBN</p>
                                <p class="mb-1"><strong>Autor:</strong> @Model.LibroEncontrado.Autor</p>
                                <p class="mb-0"><strong>Categoría:</strong> @Model.LibroEncontrado.Categoria</p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.MensajeBusqueda))
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            @Model.MensajeBusqueda
                        </div>
                    }

                    @if (Model.LibroEncontradoTitulo != null)
                    {
                        <hr />
                        <div class="card bg-light position-relative">
                            <form method="post" asp-page-handler="EliminarIndividual" asp-route-isbn="@Model.LibroEncontradoTitulo.ISBN" onsubmit="return confirm('¿Eliminar el libro con ISBN @Model.LibroEncontradoTitulo.ISBN de todo el catálogo?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger position-absolute top-0 end-0 m-2" title="Eliminar libro">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/></svg>
                                </button>
                            </form>
                            <div class="card-body">
                                <h5 class="card-title">@Model.LibroEncontradoTitulo.Titulo</h5>
                                <p class="mb-1"><strong>ISBN:</strong> @Model.LibroEncontradoTitulo.ISBN</p>
                                <p class="mb-1"><strong>Autor:</strong> @Model.LibroEncontradoTitulo.Autor</p>
                                <p class="mb-0"><strong>Categoría:</strong> @Model.LibroEncontradoTitulo.Categoria</p>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.MensajeBusquedaTitulo))
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            @Model.MensajeBusquedaTitulo
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    @* ========== MIN / MAX ISBN ========== *@
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm border-info">
                <div class="card-body text-center">
                    <h6 class="text-muted">Menor ISBN</h6>
                    @if (Model.MenorISBN != null)
                    {
                        <h4 class="text-info">[@Model.MenorISBN.ISBN] @Model.MenorISBN.Titulo</h4>
                    }
                    else
                    {
                        <p class="text-muted">No hay libros</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-warning">
                <div class="card-body text-center">
                    <h6 class="text-muted">Mayor ISBN</h6>
                    @if (Model.MayorISBN != null)
                    {
                        <h4 class="text-warning">[@Model.MayorISBN.ISBN] @Model.MayorISBN.Titulo</h4>
                    }
                    else
                    {
                        <p class="text-muted">No hay libros</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ========== TABLA DE LIBROS ========== *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0">
            Libros Registrados (@Model.Libros.Length)
        </h3>

        <form method="post"
              asp-page-handler="Eliminar"
              id="formEliminar">

            <input type="hidden"
                   id="LibrosSeleccionados"
                   name="LibrosSeleccionados"
                   value="" />

            <button type="submit"
                    id="btnEliminar"
                    class="btn btn-danger"
                    disabled>
                Eliminar Seleccionados
            </button>

        </form>
    </div>

    <div class="table-responsive">

        <table class="table table-bordered table-hover">

            <thead class="table-dark">

                <tr>
                    <th style="width: 50px;" class="text-center">
                        <input type="checkbox" id="checkAll" />
                    </th>
                    <th>
                        ISBN
                        <a asp-page="./Gestion"
                           asp-route-orden="asc"
                           class="btn btn-sm btn-outline-light ms-2"
                           title="Menor a mayor">
                            ↑
                        </a>
                        <a asp-page="./Gestion"
                           asp-route-orden="desc"
                           class="btn btn-sm btn-outline-light"
                           title="Mayor a menor">
                            ↓
                        </a>
                    </th>
                    <th>Título</th>
                    <th>Autor</th>
                    <th>Categoría</th>
                </tr>

            </thead>

            <tbody>

                @if (Model.Libros.Length == 0)
                {
                    <tr>
                        <td colspan="5"
                            class="text-center text-muted">
                            No hay libros registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var libro in Model.Libros)
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox"
                                       class="checkLibro"
                                       value="@libro.ISBN" />
                            </td>
                            <td>@libro.ISBN</td>
                            <td>@libro.Titulo</td>
                            <td>@libro.Autor</td>
                            <td>@libro.Categoria</td>
                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {
<script>

    // ========== Combo dependiente Categoría -> Subcategoría ==========
    const selectCategoria = document.getElementById("selectCategoria");
    const selectSubcategoria = document.getElementById("selectSubcategoria");

    async function cargarSubcategorias(nombreCategoria, preservar) {
        selectSubcategoria.innerHTML = '<option value="">-- Sin subcategoría --</option>';

        if (!nombreCategoria) {
            return;
        }

        try {
            const resp = await fetch('/Gestion?handler=Subcategorias&categoria=' + encodeURIComponent(nombreCategoria));
            const datos = await resp.json();

            datos.forEach(function (item) {
                const opt = document.createElement("option");
                opt.value = item.value;
                opt.textContent = item.text;
                if (preservar && item.value === preservar) {
                    opt.selected = true;
                }
                selectSubcategoria.appendChild(opt);
            });
        } catch (e) {
            console.error("Error cargando subcategorías:", e);
        }
    }

    selectCategoria.addEventListener("change", function () {
        cargarSubcategorias(selectCategoria.value, null);
    });

    // Al recargar tras un POST, repoblar subcategorías de la categoría retenida
    const subSeleccionada = "@Model.SubcategoriaSeleccionada";
    if (selectCategoria.value) {
        cargarSubcategorias(selectCategoria.value, subSeleccionada);
    }

    // Select All checkbox
    const checkAll = document.getElementById("checkAll");
    const checks = document.querySelectorAll(".checkLibro");
    const botonEliminar = document.getElementById("btnEliminar");
    const campoSeleccionados = document.getElementById("LibrosSeleccionados");

    checkAll.addEventListener("change", function ()
    {
        checks.forEach(function (check)
        {
            check.checked = checkAll.checked;
        });
        actualizarSeleccion();
    });

    function actualizarSeleccion()
    {
        let seleccionados = [];

        checks.forEach(function (check)
        {
            if (check.checked)
            {
                seleccionados.push(check.value);
            }
        });

        campoSeleccionados.value = seleccionados.join(",");
        botonEliminar.disabled = seleccionados.length === 0;
    }

    checks.forEach(function (check)
    {
        check.addEventListener("change", actualizarSeleccion);
    });

</script>
}
