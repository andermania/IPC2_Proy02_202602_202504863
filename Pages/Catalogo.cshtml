@page
@model GestiónDeBiblioteca.Pages.CatalogoModel

<div class="container mt-4">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">
            Catálogo de Categorías
        </h1>
        <p class="lead text-muted">
            Estructura jerárquica completa de categorías y subcategorías.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.MensajeExito
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.MensajeError
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">

        @* ========== AGREGAR CATEGORÍA ========== *@
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Agregar Categoría</h4>
                </div>
                <div class="card-body">
                    <form method="post" asp-page-handler="AgregarCategoria">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre</label>
                            <input asp-for="NuevaCategoria"
                                   type="text"
                                   class="form-control"
                                   placeholder="Ej: Ciencia"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">
                            Agregar Categoría Raíz
                        </button>
                    </form>

                    <hr />

                    <form method="post" asp-page-handler="AgregarSubcategoria">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Categoría Padre</label>
                            <select asp-for="CategoriaPadre"
                                    asp-items="Model.OpcionesCategorias"
                                    class="form-select"
                                    required>
                                <option value="">-- Seleccione padre --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre Subcategoría</label>
                            <input asp-for="NuevaSubcategoria"
                                   type="text"
                                   class="form-control"
                                   placeholder="Ej: Física Cuántica"
                                   required />
                        </div>

                        <button type="submit"
                                class="btn btn-outline-success w-100">
                            Agregar Subcategoría
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @* ========== ESTRUCTURA JERÁRQUICA ========== *@
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Estructura de Categorías</h4>
                    <span class="badge bg-light text-primary">
                        @Model.TotalCategorías categorías | @Model.TotalLibros libros
                    </span>
                </div>
                <div class="card-body">
                    @if (Model.EstructuraTexto.Length == 0)
                    {
                        <div class="text-center text-muted py-4">
                            <h5>No hay categorías definidas</h5>
                            <p>Agregue categorías usando el formulario de la izquierda o cargue un archivo XML.</p>
                        </div>
                    }
                    else
                    {
                        <pre class="bg-light p-3 rounded" style="overflow-x: auto; white-space: pre-wrap; font-family: 'Consolas', monospace; font-size: 14px;">@Model.EstructuraTexto</pre>
                    }
                </div>
            </div>
        </div>

    </div>

    @* ========== VISUALIZAR DESDE SUBCATEGORÍA ========== *@
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Visualizar Desde Subcategoría Específica</h4>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="VisualizarDesde" class="row g-3">
                <div class="col-md-8">
                    <select asp-for="RutaVisualizar"
                            asp-items="Model.OpcionesTodasCategorias"
                            class="form-select">
                        <option value="">-- Raíz completa --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit"
                            class="btn btn-info text-white w-100">
                        Visualizar
                    </button>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(Model.EstructuraParcial))
            {
                <hr />
                <pre class="bg-light p-3 rounded" style="overflow-x: auto; white-space: pre-wrap; font-family: 'Consolas', monospace; font-size: 14px;">@Model.EstructuraParcial</pre>
            }
        </div>
    </div>

    @* ========== ÁRBOL DE CATEGORÍAS EN GRAPHVIZ ========== *@
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h4 class="mb-0">Diagrama Visual de Categorías (Graphviz)</h4>
            <div>
                <button class="btn btn-sm btn-light me-2" id="btnCatSVG" onclick="descargarCatSVG()" disabled>
                    Descargar SVG
                </button>
                <button class="btn btn-sm btn-light me-2" id="btnCatPNG" onclick="descargarCatPNG()" disabled>
                    Descargar PNG
                </button>
                <button class="btn btn-sm btn-outline-light" onclick="cargarGraficoCategorias()">
                    Regenerar
                </button>
            </div>
        </div>
        <div class="card-body text-center">
            <div id="graficoCategorias" style="min-height: 200px;">
                <p class="text-muted">Cargando diagrama...</p>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
    function mostrarDotComoTexto(container, dot, motivo) {
        var safe = dot.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        container.innerHTML =
            '<div class="alert alert-warning">' + motivo + '</div>' +
            '<div class="mb-2">' +
            '<button class="btn btn-sm btn-outline-secondary me-2" onclick="copiarDot(this)">Copiar DOT</button>' +
            '<button class="btn btn-sm btn-outline-secondary me-2" onclick="descargarDot(this)">Descargar .dot</button>' +
            '<a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" href="https://dreampuf.github.io/GraphvizOnline/">Abrir en GraphvizOnline</a>' +
            '</div>' +
            '<pre class="bg-light p-3 rounded text-start" style="overflow-x:auto; white-space:pre-wrap; font-size:12px;" data-dot></pre>';
        container.querySelector('[data-dot]').textContent = dot;
    }

    function copiarDot(btn) {
        var pre = btn.closest('div').parentElement.querySelector('[data-dot]');
        navigator.clipboard.writeText(pre.textContent).then(function () { btn.textContent = 'Copiado'; });
    }

    function descargarDot(btn) {
        var pre = btn.closest('div').parentElement.querySelector('[data-dot]');
        var blob = new Blob([pre.textContent], { type: 'text/vnd.graphviz' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'diagrama.dot';
        a.click();
    }

    var svgCategorias = null;

    function actualizarBotonesCat() {
        var hay = !!svgCategorias;
        document.getElementById('btnCatSVG').disabled = !hay;
        document.getElementById('btnCatPNG').disabled = !hay;
    }

    function descargarCatSVG() {
        if (!svgCategorias) {
            return;
        }
        var xml = new XMLSerializer().serializeToString(svgCategorias);
        var blob = new Blob([xml], { type: 'image/svg+xml;charset=utf-8' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'categorias.svg';
        a.click();
        setTimeout(function() { URL.revokeObjectURL(a.href); }, 5000);
    }

    function descargarCatPNG() {
        if (!svgCategorias) {
            return;
        }
        var xml = new XMLSerializer().serializeToString(svgCategorias);
        var url = URL.createObjectURL(new Blob([xml], { type: 'image/svg+xml;charset=utf-8' }));
        var img = new Image();
        img.onload = function() {
            try {
                var escala = 2;
                var w = svgCategorias.clientWidth || img.width || 800;
                var h = svgCategorias.clientHeight || img.height || 600;
                var canvas = document.createElement('canvas');
                canvas.width = Math.round(w * escala);
                canvas.height = Math.round(h * escala);
                var ctx = canvas.getContext('2d');
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                URL.revokeObjectURL(url);
                canvas.toBlob(function(blob) {
                    if (!blob) {
                        return;
                    }
                    var a = document.createElement('a');
                    a.href = URL.createObjectURL(blob);
                    a.download = 'categorias.png';
                    a.click();
                    setTimeout(function() { URL.revokeObjectURL(a.href); }, 5000);
                }, 'image/png');
            } catch (e) {
                URL.revokeObjectURL(url);
            }
        };
        img.onerror = function() { URL.revokeObjectURL(url); };
        img.src = url;
    }

    function cargarGraficoCategorias() {
        var container = document.getElementById('graficoCategorias');
        svgCategorias = null;
        actualizarBotonesCat();
        fetch('/Catalogo?handler=DotCategorias')
            .then(function (r) { return r.text(); })
            .then(function (dot) {
                if (typeof Viz === 'undefined') {
                    mostrarDotComoTexto(container, dot, 'No se pudo cargar el motor de diagramas local (viz.js). Se muestra el código DOT; puede copiarlo o abrirlo en GraphvizOnline.');
                    return;
                }
                try {
                    var viz = new Viz();
                    viz.renderSVGElement(dot)
                        .then(function (svg) {
                            container.innerHTML = '';
                            svg.style.maxWidth = '100%';
                            svg.style.height = 'auto';
                            container.appendChild(svg);
                            svgCategorias = svg;
                            actualizarBotonesCat();
                        })
                        .catch(function (err) {
                            var detalle = (err && err.message) ? err.message : String(err);
                            mostrarDotComoTexto(container, dot, 'Error renderizando el diagrama: ' + detalle);
                        });
                } catch (e) {
                    var detalle2 = (e && e.message) ? e.message : String(e);
                    mostrarDotComoTexto(container, dot, 'Error iniciando viz.js: ' + detalle2);
                }
            })
            .catch(function (err) {
                container.innerHTML =
                    '<div class="alert alert-danger">Error cargando DOT: ' + err + '</div>';
            });
    }

    // Cargar al inicio
    window.addEventListener('load', cargarGraficoCategorias);
</script>
}
